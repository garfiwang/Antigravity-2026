# ==========================================
# Antigravity-2026 環境變數範例檔
# 請複製此檔為 .env 並填入自己的 API 金鑰
# 警告：切勿將包含真實金鑰的 .env 提交至 Git！
# ==========================================

# Reurl.cc 短網址服務 API Key (亦可存放於 ~/.reurl.env)
REURL_API_KEY=your_reurl_api_key_here
REURL_API_URL=https://api.reurl.cc/shorten

# OpenAI API Key (生圖、模型推論)
OPENAI_API_KEY=your_openai_api_key_here

# Google / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Notion 整合金鑰
NOTION_TOKEN=your_notion_token_here

# Firebase 網頁設定 (若有前端專案需要)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_project_id_here
